<mujoco model="panda reach">
  <!-- Franka Panda + floor + lights + options (MJX-tuned). -->
  <include file="mjx_scene.xml"/>

  <worldbody>
    <!-- Fixed camera framing the reachable workspace in front of the robot.
         This is the image the vision encoder sees. -->
    <camera name="overhead_cam" pos="1.15 0.0 0.65" xyaxes="0 1 0 -0.42 0 0.91"/>

    <!-- Reach target: a mocap body (no dof) whose position we randomize each
         episode via data.mocap_pos. Rendered in geom group 0 so it is visible. -->
    <body name="target" mocap="true" pos="0.45 0.0 0.30">
      <geom name="target_geom" type="sphere" size="0.03" rgba="0.9 0.1 0.1 1"
        contype="0" conaffinity="0" group="0"/>
    </body>
  </worldbody>

  <keyframe>
    <!-- Neutral "home" arm pose (7 arm joints + 2 finger joints), gripper open. -->
    <key name="home"
      qpos="0 0.3 0 -1.57079 0 2.0 -0.7853 0.04 0.04"
      ctrl="0 0.3 0 -1.57079 0 2.0 -0.7853 0.04"/>
  </keyframe>
</mujoco>
