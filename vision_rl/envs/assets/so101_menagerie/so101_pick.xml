<mujoco model="so101 pick (menagerie)">
  <!-- Menagerie SO-101 robot (proper collision fingers). meshdir=assets is set
       inside so101.xml; option/defaults/actuators come from it too. -->
  <include file="so101.xml"/>

  <!-- MJX/warp contact buffers: the full-body-collision robot + cube + table
       generate many contacts; give them headroom. -->
  <custom>
    <numeric data="40" name="max_contact_points"/>
    <numeric data="16" name="max_geom_pairs"/>
  </custom>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.4 0.4 0.4" specular="0 0 0"/>
    <global azimuth="130" elevation="-30"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="512"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.25 0.28 0.32" rgb2="0.18 0.20 0.24" markrgb="0.6 0.6 0.6"
             width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="4 4" reflectance="0.1"/>
    <material name="cube_mat" rgba="1 0.85 0.05 1"/>
    <material name="table_mat" rgba="0.80 0.79 0.75 1"/>
    <material name="leg_mat" rgba="0.30 0.22 0.14 1"/>
  </asset>

  <worldbody>
    <light pos="0.2 -0.2 0.8" dir="0 0 -1" directional="true"/>
    <!-- Ground below the table; table top is flush at z=0 (the workspace). -->
    <geom name="floor" type="plane" pos="0 0 -0.4" size="0 0 0.05" material="groundplane"
          contype="1" conaffinity="1" condim="3"/>
    <geom name="tabletop" type="box" pos="0.10 0.0 -0.02" size="0.30 0.28 0.02"
          material="table_mat" contype="1" conaffinity="1" condim="3"
          friction="1.0 0.02 0.001"/>
    <geom name="leg1" type="box" pos="0.36 0.24 -0.21" size="0.02 0.02 0.18" material="leg_mat" contype="0" conaffinity="0"/>
    <geom name="leg2" type="box" pos="0.36 -0.24 -0.21" size="0.02 0.02 0.18" material="leg_mat" contype="0" conaffinity="0"/>
    <geom name="leg3" type="box" pos="-0.16 0.24 -0.21" size="0.02 0.02 0.18" material="leg_mat" contype="0" conaffinity="0"/>
    <geom name="leg4" type="box" pos="-0.16 -0.24 -0.21" size="0.02 0.02 0.18" material="leg_mat" contype="0" conaffinity="0"/>

    <!-- 4.5x4.5x3.5 cm cube to pick. contype=2/conaffinity=1 collides with the
         robot (incl. gripper pads), table and floor — full physics, no grasp-assist. -->
    <body name="cube" pos="0.18 0.0 0.0175">
      <freejoint name="cube_free"/>
      <geom name="cube" type="box" size="0.0225 0.0225 0.0175" material="cube_mat"
            contype="2" conaffinity="1" condim="4" friction="1.0 0.05 0.001"
            solref="0.01 1" solimp="0.95 0.99 0.001" mass="0.03"/>
    </body>

    <!-- Overhead-ish camera framing the workspace from the -y side, tilted ~6
         degrees up from the original pick-place pitch to match the real camera mount. -->
    <camera name="overhead_cam" pos="0.16 -0.42 0.34" xyaxes="1 0 0 0 0.537 0.843"/>
  </worldbody>

  <keyframe>
    <!-- home: 5 arm joints + gripper(closed) then cube freejoint (xyz + quat).
         Recalibrated against the real arm (scripts/check_calibration.py) after
         fixing the wrist_roll sim/real offset via that joint's `ref` in
         so101.xml -- the previous home commanded a pose that hit the table on
         hardware. That pose was jogged and verified safe on the real robot.

         wrist_flex RAISED 0.95068 -> 0.45 (2026-07-23): the verified pose put
         the grasp site at z=0.0169 -- i.e. AT cube height and INSIDE the cube
         spawn box (home gripper xy = 0.183,-0.013) -- so ~16% of resets spawned
         the cube interpenetrating the closed jaw by up to 12.7mm, which
         detonated on the first step (qvel spikes, occasional NaN). It was also
         below table_clear=0.02, firing the table penalty at every reset.
         Raising the wrist lifts the grasp site to z=0.0789 (~8cm, the hover
         height the top-down reward targets) and drops cube-in-gripper to 0%.
         Verified to cost nothing in reach: top-down coverage of the spawn box
         is unchanged (96.7% @25deg, 100% @35deg at action_scale=1.8).
         NOTE: this pose differs from the hardware-jogged one -- re-verify on
         the real arm before deploying. It moves the wrist AWAY from the table,
         so it is the safe direction.

         wrist_roll 1.58598 -> 0.0 (2026-08-01): at grasp height (gripper open,
         reaching over the cube) the moving jaw physically hit the tabletop for
         wrist_roll in roughly [52,140] deg -- the jaw's open sweep dips into
         the table because that roll orientation opens it front-to-back rather
         than side-to-side. Verified by contact sweep: wrist_roll in
         [-157,35] deg (and near +157) is clear across the ENTIRE gripper-open
         range at this reach. 0.0 sits centered in that clear band. Costs
         nothing mechanically -- the cube is square in xy, so grasp quality is
         unaffected by which horizontal angle the jaws close from. -->
    <key name="home"
      qpos="0.08954 -1.74533 1.64009 0.45 0.0 -0.17453  0.18 0.0 0.0175 1 0 0 0"
      ctrl="0.08954 -1.74533 1.64009 0.45 0.0 -0.17453"/>

    <!-- action_center (2026-08-02): the residual action decode's reference
         point -- arm_ctrl = action_center + action_scale*action -- is now
         DECOUPLED from `home` above. `home` is still what the arm physically
         resets to (hardware-verified, must not move). But `home` sits AT/NEAR
         several joint limits (shoulder_lift exactly at its lower bound,
         elbow_flex 2.9deg from its upper bound), so at action_scale=1.8 a
         large fraction of the policy's action distribution saturates against
         those limits with zero gradient (measured: shoulder_lift 55% dead,
         elbow_flex 53% dead, mean 29.3% across the 5 arm joints) -- this is
         the "joint 3 (elbow) won't go up" / reach-limited symptom.
         action_center keeps the SAME gripper hover position as `home` (within
         5mm) and the SAME wrist_roll=0 (jaw-clearance fix) but is centered
         well inside each joint's range instead of against a wall: mean dead
         action drops 29.3% -> 20.0%, spawn-box reach stays 100%, and random-
         policy time spent near the cube ("useful-zone") barely changes
         (81.1% -> 77.8%) -- unlike the alternatives tried (absolute control,
         a +-90deg cap, or an all-zero pose), which all collapsed useful-zone
         to ~2.5% by moving the exploration prior far from the cube.
         Read by name (`action_center`) in envs/so101_pick.py and
         deploy/bridge.py -- NOT by keyframe index -- so both stay in sync
         from this single source of truth, the same pattern `home` already
         uses. Gripper channel here is unused (gripper is absolute-mapped,
         not residual) -- copied from `home` for a valid keyframe. -->
    <key name="action_center"
      qpos="0.08839 -0.82001 0.86169 0.84540 0.0 -0.17453  0.18 0.0 0.0175 1 0 0 0"
      ctrl="0.08839 -0.82001 0.86169 0.84540 0.0 -0.17453"/>
  </keyframe>
</mujoco>
